<?xml version="1.0"?>

<!-- ===================================================== -->
<!-- RF-SRC Benchmark Suite     Apache Ant version 1.8.0   -->
<!-- ===================================================== -->

<project name="RF-SRC(M) Benchmark Suite" basedir="." default="bench-suite-build-64">

  <property name="project.name" value="RF-SRC(M) Benchmark Suite"/>
  <property name="project.version" value=""/>
  <property name="project.build" value=""/>

  <!-- Generic project properties -->
  <property name="project.core.name" value="benchmark"/>
  <property name="logFile" value="${project.core.name}.log"/>

  <!-- Static Locations -->
  <property name="qacDir" value="quality"/>


  <!--
    ========================================================================
    ========================================================================
      Include Internal Common Targets..
    ========================================================================
    ========================================================================
  -->
  <include file="internal.xml"/>



  <!--
    ========================================================================
      INTERNAL BENCHMARK CRAN targets follow.
    ========================================================================
  -->


  <!--
    ========================================================================
      Internal Target:  Set build tree.
    ========================================================================
  -->
  <target name="setBuildTree" depends="internal.init,internal.testBuildTree">
  </target>


  <!--
    ========================================================================
      Internal Target:  setPackageUseTrue, setPackageUseFalse
    ========================================================================
  -->
  <target name="setPackageUseTrue">
    <property name="packageUse" value="TRUE"/>
  </target>

  <target name="setPackageUseFalse">
    <property name="packageUse" value="FALSE"/>
  </target>

  <!--
    ========================================================================
      Internal Target:  setUpdateBenchmarkTrue, setUpdateBenchmarkFalse
    ========================================================================
  -->
  <target name="setUpdateBenchmarkTrue">
    <property name="updateBenchmark" value="TRUE"/>
  </target>

  <target name="setUpdateBenchmarkFalse">
    <property name="updateBenchmark" value="FALSE"/>
  </target>


 <!--
    ========================================================================
      Internal target, bench-suite-generic
    ========================================================================
  -->
  <target name="bench-suite-generic" depends="internal.isRarchSet">

    <echo message="Benchmark Target Initiated with
                   -use.package=${packageUse} -update.benchmark=${updateBenchmark}"/>

    <echo file="${qacDir}/test${scriptExtension}" append="false">${scriptFileCommentLine}
R ${Rarch} CMD BATCH --no-restore --no-save test.R output${sep}${logFile}
${scriptFileExitLine}
    </echo>



    <echo message="  test"/>
    <exec dir="${qacDir}" executable="R" failonerror="TRUE">
      <arg line="${Rarch} CMD BATCH --no-restore --no-save "/>
      <arg line="-use.package=${packageUse}
                 -update.benchmark=${updateBenchmark} test.R"/>
      <arg line="output${sep}${logFile}"/>
    </exec>
    <echo message="    grow.txt"/>
    <exec dir="${qacDir}" executable="diff">
      <arg line="-w output/grow.txt benchmark/grow.txt"/>
    </exec>

  </target>




  <!--
    ========================================================================
      External BENCHMARK CRAN targets follow.
    ========================================================================
  -->


 <!--
    ========================================================================
      BENCH-SUITE-PACKAGE-XX target, Entry Point
    ========================================================================
  -->
  <target name="bench-suite-package-32" depends="setBuildTree,internal.osPrep,internal.set32,setUpdateBenchmarkFalse,setPackageUseTrue,bench-suite-generic"/>
  <target name="bench-suite-package-64" depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkFalse,setPackageUseTrue,bench-suite-generic"/>

 <!--
    ========================================================================
      BENCH-SUITE-BUILD-XX target, Entry Point
    ========================================================================
  -->
  <target name="bench-suite-build-32" depends="setBuildTree,internal.osPrep,internal.set32,setUpdateBenchmarkFalse,setPackageUseFalse,bench-suite-generic"/>
  <target name="bench-suite-build-64" depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkFalse,setPackageUseFalse,bench-suite-generic"/>


 <!--
    ========================================================================
      BENCH-SUITE-UPDATE-XX target, Entry Point
    ========================================================================
  -->
  <target name="bench-suite-update-32"  depends="setBuildTree,internal.osPrep,internal.set32,setUpdateBenchmarkTrue,setPackageUseFalse,bench-suite-generic"/>
  <target name="bench-suite-update-64"  depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkTrue,setPackageUseFalse,bench-suite-generic"/>


  <!--
    ========================================================================
      Help on usage.  List available targets
    ========================================================================
    -->
  <target name="usage" depends="internal.init">
    <echo message=""/>
    <echo message=" Available targets are:"/>
    <echo message=""/>
    <echo message=" bench-suite-package-xx"/>
    <echo message="     --> run the benchmark suite tests in xx-bit mode on the CRAN package"/>
    <echo message=" bench-suite-build-xx"/>
    <echo message="     --> run the benchmark suite tests in xx-bit mode on the build"/>
    <echo message="     --> the DEFAULT target is 64-bit execution"/>
    <echo message=""/>
    <echo message=" bench-suite-update-xx"/>
    <echo message="     --> update the benchmark suite tests in xx-bit mode on the build"/>
    <echo message=""/>

  </target>

</project>



