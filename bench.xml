<?xml version="1.0"?>

<!-- ===================================================== -->
<!-- RF-SRC Benchmark Suite     Apache Ant version 1.8.0   -->
<!-- ===================================================== -->

<project name="BOOSTMTREE Benchmark Suite" basedir="." default="suite-build">

  <property name="project.name" value="BOOSTMTREE Benchmark Suite"/>
  <property name="project.version" value="_PROJECT_VERSION_ID_"/>
  <property name="project.build" value="_PROJECT_BUILD_ID_"/>
  <property name="stealth.flag" value="RF_STLTH_FLAG"/>

  <!-- Generic project properties -->
  <property name="logFile" value="benchmark.log"/>

  <!-- Static Locations -->
  <property name="qacDir" value="quality"/>


  <!--
    ========================================================================
    ========================================================================
      Include Internal Common Targets..
    ========================================================================
    ========================================================================
  -->
  <include file="internal.xml"/>



  <!--
    ========================================================================
      INTERNAL BENCHMARK CRAN targets follow.
    ========================================================================
  -->


  <!--
    ========================================================================
      Internal Target:  Set build tree.
    ========================================================================
  -->
  <target name="setBuildTree" depends="internal.init,internal.testBuildTree">
  </target>


  <!--
    ========================================================================
      Internal Target:  setPackageUseTrue, setPackageUseFalse
    ========================================================================
  -->
  <target name="setPackageUseTrue">
    <property name="packageUse" value="TRUE"/>
  </target>

  <target name="setPackageUseFalse">
    <property name="packageUse" value="FALSE"/>
  </target>

  <!--
    ========================================================================
      Internal Target:  setUpdateBenchmarkTrue, setUpdateBenchmarkFalse
    ========================================================================
  -->
  <target name="setUpdateBenchmarkTrue">
    <property name="updateBenchmark" value="TRUE"/>
  </target>

  <target name="setUpdateBenchmarkFalse">
    <property name="updateBenchmark" value="FALSE"/>
  </target>


 <!--
    ========================================================================
      Internal target, suite-generic
    ========================================================================
  -->
  <target name="suite-generic" depends="internal.isRarchSet">

    <echo message="Benchmark Target Initiated with"/>
    <echo message="  -use.package=${packageUse}"/>
    <echo message="  -update.benchmark=${updateBenchmark}"/>
    <echo message="  -stealth.flag=${stealth.flag}"/>
    <echo message=""/>

    <echo file="${qacDir}/test${scriptExtension}" append="false">${scriptFileCommentLine}
R ${Rarch} CMD BATCH --no-restore --no-save test.R output${sep}${logFile}
${scriptFileExitLine}
    </echo>

    <echo message="  test"/>
    <exec dir="${qacDir}" executable="R" failonerror="TRUE">
      <arg line="${Rarch} CMD BATCH --no-restore --no-save "/>
      <arg line="-use.package=${packageUse}
                 -update.benchmark=${updateBenchmark}
                 -stealth.flag=${stealth.flag} test.R"/>
      
      <arg line="output${sep}${logFile}"/>
    </exec>
    <echo message="    grow.txt"/>
    <exec dir="${qacDir}" executable="diff">
      <arg line="-w output/grow.txt benchmark/grow.txt"/>
    </exec>

  </target>

 <!--
    ========================================================================
      Internal target, examples-generic
    ========================================================================
  -->
  <target name="examples-generic" depends="internal.isRarchSet">

    <echo message="Benchmark Target Initiated with"/>
    <echo message="  -use.package=${packageUse}"/>
    <echo message="  -update.benchmark=${updateBenchmark}"/>
    <echo message="  -stealth.flag=${stealth.flag}"/>
    <echo message=""/>

    <echo file="${qacDir}/all.examples${scriptExtension}" append="false">${scriptFileCommentLine}
R ${Rarch} CMD BATCH --no-restore --no-save all.examples.R output${sep}${logFile}
${scriptFileExitLine}
    </echo>

    <echo message="  all.examples"/>
    <exec dir="${qacDir}" executable="R" failonerror="TRUE">
      <arg line="${Rarch} CMD BATCH --no-restore --no-save"/>
      <arg line="-use.package=${packageUse}
                 -update.benchmark=${updateBenchmark}
                 -stealth.flag=${stealth.flag} all.examples.R"/>
      <arg line="output${sep}${logFile}"/>
    </exec>
    <echo message="    all.examples.txt"/>
    <exec dir="${qacDir}" executable="diff">
      <arg line="-w output/all.examples.txt benchmark/all.examples.txt"/>
    </exec>

  </target>


  <!--
    ========================================================================
      External BENCHMARK CRAN targets follow.
    ========================================================================
  -->

 <!--
    ========================================================================
      SUITE-PACKAGE-XX target, Entry Point
    ========================================================================
  -->
  <target name="suite-package" depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkFalse,setPackageUseTrue,suite-generic"/>

 <!--
    ========================================================================
      SUITE-BUILD-XX target, Entry Point
    ========================================================================
  -->
  <target name="suite-build" depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkFalse,setPackageUseFalse,suite-generic"/>

  <!--
    ========================================================================
      EXAMPLES-PACKAGE-XX target, Entry Point
    ========================================================================
  -->
  <target name="examples"    depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkFalse,setPackageUseTrue,examples-generic"/>

  <!--
    ========================================================================
      SUITE-UPDATE-XX target, Entry Point
    ========================================================================
  -->
  <target name="suite-update"  depends="setBuildTree,internal.osPrep,internal.set64,setUpdateBenchmarkTrue,setPackageUseFalse,suite-generic"/>


  <!--
    ========================================================================
      Help on usage.  List available targets
    ========================================================================
    -->
  <target name="usage" depends="internal.init">
    <echo message=""/>
    <echo message=" Available targets are:"/>
    <echo message=""/>
    <echo message=" suite-package"/>
    <echo message="     --> run the benchmark suite tests in 64-bit mode on the CRAN package"/>
    <echo message=""/>
    <echo message=" examples"/>
    <echo message="     --> run the benchmark Rd tests in 64-bit mode on the CRAN package"/>
    <echo message=""/>
    <echo message=" suite-build"/>
    <echo message="     --> run the benchmark suite tests in 64-bit mode on the build"/>
    <echo message="     --> *** DEFAULT TARGET ***"/>
    <echo message=""/>
    <echo message=" suite-update"/>
    <echo message="     --> update the benchmark suite tests in 64-bit mode on the build"/>
    <echo message=""/>

  </target>

</project>



