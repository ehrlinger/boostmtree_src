<?xml version="1.0"?>

<!-- ===================================================== -->
<!-- BOOSTMTREE Project File        Apache Ant version 1.9.0   -->
<!-- ===================================================== -->

<project name="BOOSTMTREE Build Suite" basedir="." default="serial">

  <!-- Generic project properties -->
  <property name="project.name" value="BOOSTMTREE Build Suite"/>
  <property name="project.version.token" value="_PROJECT_VERSION_ID_"/>
  <property name="project.version" value="1.0.0"/>
  <property name="project.build.token" value="_PROJECT_BUILD_ID_"/>
  <property name="project.build" value="bld20160316"/>
  <property name="project.pkg.name.token" value="_PROJECT_PACKAGE_NAME_"/>
  <property name="rfsrc.pkg.name.token" value="_RFSRC_PACKAGE_NAME_"/>

  
  <property name="http.prefix.token" value="_HTTP_PREFIX_"/>
  <property name="http.prefix" value="http://"/>

  <property environment="env"/>

  <!-- Static Locations -->
  <property name="qacDir" value="docs/quality"/>
  <property name="pkgDir"  value="cran"/>


  <!--
    ========================================================================
    ========================================================================
      Include Internal Common Targets..
    ========================================================================
    ========================================================================
  -->
  <include file="internal.xml"/>


  <!--
    ========================================================================
    ========================================================================
      Internal CRAN targets follow.  Not for end use.
    ========================================================================
    ========================================================================
  -->


  <!--
    ========================================================================
      Internal Target:  Set package for Multivariate
    ========================================================================
  -->
  <target name="setMltvariate">
    <property name="project.pkg.name"  value="boostmtree"/>
    <property name="rfsrc.pkg.name"  value="randomForestSRC"/>
    <property name="logFile" value="boostmtree.log"/>

    <property name="mltvariate.r.switch.beg.token" value="## RF_MLTVR_BEG ##" />
    <property name="mltvariate.r.switch.end.token" value="## RF_MLTVR_END ##" />

    <property name="mltvariate.switch.beg"       value="" />
    <property name="mltvariate.switch.end"       value="" />

    <property name="stealth.r.switch.beg.token" value="## RF_STLTH_BEG ##" />
    <property name="stealth.r.switch.end.token" value="## RF_STLTH_END ##" />

    <property name="stealth.switch.beg"       value="/*" />
    <property name="stealth.switch.end"       value="*/" />

    <property name="exclude.R.files"       value="exclude.stealth.R.txt" />
    <property name="exclude.Rd.files"      value="exclude.stealth.Rd.txt" />

    <property name="mltvariate.flag.token"       value="RF_MLTVR_FLAG" />    
    <property name="mltvariate.flag"             value="TRUE" />
              
    <property name="stealth.flag.token"          value="RF_STLTH_FLAG" />    
    <property name="stealth.flag"                value="FALSE" />

  </target>

  <!--
    ========================================================================
      Internal Target:  Set package for Stealth
    ========================================================================
  -->
  <target name="setStealth">
    <property name="project.pkg.name"  value="boostmtree.stealth"/>
    <property name="rfsrc.pkg.name"  value="randomForestSRC.stealth"/>
    <property name="logFile" value="boostmtree.log"/>

    <property name="mltvariate.r.switch.beg.token" value="## RF_MLTVR_BEG ##" />
    <property name="mltvariate.r.switch.end.token" value="## RF_MLTVR_END ##" />

    <property name="mltvariate.switch.beg"       value="/*" />
    <property name="mltvariate.switch.end"       value="*/" />

    <property name="stealth.r.switch.beg.token" value="## RF_STLTH_BEG ##" />
    <property name="stealth.r.switch.end.token" value="## RF_STLTH_END ##" />

    <property name="stealth.switch.beg"       value="" />
    <property name="stealth.switch.end"       value="" />

    <property name="exclude.R.files"       value="exclude.multivariate.R.txt" />
    <property name="exclude.Rd.files"      value="exclude.multivariate.Rd.txt" />

    <property name="mltvariate.flag.token"       value="RF_MLTVR_FLAG" />    
    <property name="mltvariate.flag"             value="FALSE" />
              
    <property name="stealth.flag.token"          value="RF_STLTH_FLAG" />    
    <property name="stealth.flag"                value="TRUE" />
              
  </target>

  <!--
    ========================================================================
      Internal Target:  Set source tree.
    ========================================================================
  -->
  <target name="setSourceTree" depends="internal.init,internal.testSourceTree">
    <property name="bldDir" value="../build"/>
  </target>


  <!--
    ========================================================================
      Internal Target:  Prepare the CRAN output directories
    ========================================================================
  -->
  <target name="prepare" depends="setSourceTree,internal.osPrep">

    <mkdir dir="${bldDir}"/>
    <mkdir dir="${bldDir}/quality"/>
    <mkdir dir="${bldDir}/quality/data"/>

    <mkdir dir="${bldDir}/quality/benchmark"/>
    <mkdir dir="${bldDir}/quality/output"/>

    <copy file="bench.xml" todir="${bldDir}"/>
    <copy file="internal.xml" todir="${bldDir}"/>
    <move file="${bldDir}/bench.xml" tofile="${bldDir}/build.xml"/>
    <replace file="${bldDir}/build.xml" token="${project.version.token}" value="${project.version}"/>
    <replace file="${bldDir}/build.xml" token="${project.build.token}" value="${project.build}"/>
    <replace file="${bldDir}/build.xml" token="${stealth.flag.token}"  value="${stealth.flag}"/>
    <replace file="${bldDir}/build.xml" token="${project.build.token}" value="${project.build}"/>

    <copy file="docs/build.properties" todir="${bldDir}"/>

  </target>


  <!--
    ========================================================================
      Internal Target:  Copy the supporting CRAN files to the build tree.
    ========================================================================
  -->
  <target name="quality" depends="prepare,source-package">
    <copy todir="${bldDir}/quality/data">
      <fileset dir="${pkgDir}/data">
        <include name="*.txt"/>
        <include name="*.csv"/>
      </fileset>
    </copy>

    <copy todir="${bldDir}/quality/data">
      <fileset dir="${qacDir}/data">
        <include name="*.txt"/>
        <include name="*.rda"/>
      </fileset>
    </copy>


    <copy todir="${bldDir}/quality">
      <fileset dir="${qacDir}">
        <include name="*.R"/>
      </fileset>
      <filterchain>
        <tokenfilter>
          <replacestring from="${project.pkg.name.token}" to="${project.pkg.name}"/>
        </tokenfilter>
      </filterchain>
    </copy>

    <copy todir="${bldDir}/quality/benchmark">
      <fileset dir="${qacDir}/benchmark">
        <include name="*.txt"/>
        <include name="*.csv"/>
      </fileset>
    </copy>


    <replace file="${bldDir}/quality/load.R" token="_PROJECT_LIBRARY_NAME_" value="${project.pkg.name}${sharedObjectExtension}"/>
    <replace file="${bldDir}/quality/load.R" token="_PROJECT_ARCH_TYPE_" value="${Rlib}"/>
    <replace file="${bldDir}/quality/load.R" token="_PROJECT_SUPPORT_OPENMP_" value="${openMPswitch}"/>

    <replace file="${bldDir}/quality/load.R" token="${project.version.token}" value="${project.version}"/>
    <replace file="${bldDir}/quality/load.R" token="${project.build.token}" value="${project.build}"/>

    <echo file="${bldDir}/quality/generic${scriptExtension}" append="false">${scriptFileCommentLine}
R ${Rarch} CMD BATCH --no-restore --no-save generic.R output${sep}${logFile}
${scriptFileExitLine}
    </echo>

    <!--
       TBD TBD TBD  Bivariate Boosting Benchmarks TBD TBD TBD
    -->

    <chmod dir="${bldDir}/quality" perm="u+rwx" includes="*${scriptExtension}" os="Linux,Mac OS X,SunOS"/>

  </target>

  

  <!--
    ========================================================================
      Internal target, source-package
    ========================================================================
  -->
  <target name="source-package" depends="setSourceTree">

    <mkdir  dir="${bldDir}"/>
    <mkdir  dir="${bldDir}/cran"/>
    <mkdir  dir="${bldDir}/cran/${project.pkg.name}"/>
    <mkdir  dir="${bldDir}/cran/${project.pkg.name}/inst"/>
    <mkdir  dir="${bldDir}/cran/${project.pkg.name}/data"/>
    <mkdir  dir="${bldDir}/cran/${project.pkg.name}/man"/>
    <mkdir  dir="${bldDir}/cran/${project.pkg.name}/R"/>

    <copy todir="${bldDir}/cran/${project.pkg.name}/R">
      <fileset dir="${pkgDir}/R">
        <include name="*.R"/>
	      <excludesfile name="${exclude.R.files}"/>
      </fileset>

      <filterchain>
        <tokenfilter>
          <replacestring from="${mltvariate.r.switch.beg.token}" to="${mltvariate.switch.beg}"/>
          <replacestring from="${mltvariate.r.switch.end.token}" to="${mltvariate.switch.end}"/>
          <replacestring from="${stealth.r.switch.beg.token}" to="${stealth.switch.beg}"/>
          <replacestring from="${stealth.r.switch.end.token}" to="${stealth.switch.end}"/>
        </tokenfilter>
      </filterchain>

      <filterchain>
        <fixcrlf eol="lf"/>
      </filterchain>
      <filterchain>
        <replacestring from="##" to="//"/>
        <stripjavacomments/>
        <tokenfilter>
            <ignoreblank/>
        </tokenfilter>
      </filterchain>

      <filterchain>
        <concatfilter prepend="${pkgDir}/copyright"/>
        <tokenfilter>
          <replacestring from="${project.pkg.name.token}" to="${project.pkg.name}"/>
          <replacestring from="${project.version.token}" to="${project.version}"/>
          <replacestring from="////" to="####"/>
        </tokenfilter>
      </filterchain>

      <filterchain>
        <fixcrlf eol="lf"/>
      </filterchain>

    </copy>

    <copy todir="${bldDir}/cran/${project.pkg.name}/man">
      <fileset dir="${pkgDir}/man">
        <include name="*.Rd"/>
        <excludesfile name="${exclude.Rd.files}"/>
      </fileset>

      <filterchain>
        <tokenfilter>
          <replacestring from="${mltvariate.r.switch.beg.token}" to="${mltvariate.switch.beg}"/>
          <replacestring from="${mltvariate.r.switch.end.token}" to="${mltvariate.switch.end}"/>
          <replacestring from="${stealth.r.switch.beg.token}" to="${stealth.switch.beg}"/>
          <replacestring from="${stealth.r.switch.end.token}" to="${stealth.switch.end}"/>
        </tokenfilter>
      </filterchain>

      <filterchain>
        <fixcrlf eol="lf"/>
      </filterchain>
      <filterchain>
        <stripjavacomments/>
      </filterchain>

      <filterchain>
        <tokenfilter>
          <replacestring from="${http.prefix.token}" to="${http.prefix}"/>
        </tokenfilter>
      </filterchain>

      <filterchain>
        <tokenfilter>
          <replacestring from="${project.pkg.name.token}" to="${project.pkg.name}"/>
        </tokenfilter>
      </filterchain>

    </copy>


    <copy file="${pkgDir}/NAMESPACE" todir="${bldDir}/cran/${project.pkg.name}">
      <filterchain>
        <tokenfilter>
          <replacestring from="${project.pkg.name.token}" to="${project.pkg.name}"/>
          <replacestring from="${rfsrc.pkg.name.token}" to="${rfsrc.pkg.name}"/>
        </tokenfilter>
      </filterchain>

      <filterchain>
        <stripjavacomments/>
      </filterchain>
    </copy>

    <copy file="${pkgDir}/inst/CITATION" todir="${bldDir}/cran/${project.pkg.name}/inst/"/>
    <replace file="${bldDir}/cran/${project.pkg.name}/inst/CITATION" token="${project.pkg.name.token}" value="${project.pkg.name}"/>

    <copy file="${pkgDir}/DESCRIPTION" todir="${bldDir}/cran/${project.pkg.name}">
      <filterchain>
        <tokenfilter>
          <replacestring from="${project.pkg.name.token}" to="${project.pkg.name}"/>
          <replacestring from="${project.version.token}"  to="${project.version}"/>
          <replacestring from="_PROJECT_DSTAMP_"          to="${DSTAMP}"/>
          <replacestring from="${rfsrc.pkg.name.token}" to="${rfsrc.pkg.name}"/>
        </tokenfilter>
      </filterchain>
    </copy>
    
    <copy file="${pkgDir}/inst/NEWS" todir="${bldDir}/cran/${project.pkg.name}/inst">
      <filterchain>
        <tokenfilter>
          <replacestring from="${project.pkg.name.token}" to="${project.pkg.name}"/>
          <replacestring from="${project.version.token}" to="${project.version}"/>
          <replacestring from="${project.build.token}" to="${project.build}"/>
        </tokenfilter>
      </filterchain>
    </copy>

    <!--
      Compress Data Files ...
    -->

    <mkdir dir="${bldDir}/cran/staged"/>
    <copy file="docs/scripts/compressData.R" todir="${bldDir}/cran/staged"/>

    <copy todir="${bldDir}/cran/staged">
      <fileset dir="${pkgDir}/data">
        <include name="*.txt"/>
      </fileset>
    </copy>

    <exec dir="${bldDir}/cran/staged" executable="R" failonerror="TRUE">
      <arg line="CMD BATCH --no-restore --no-save "/>
      <arg line="compressData.R"/>
      <arg line="compressData.log"/>
    </exec>

    <copy todir="${bldDir}/cran/${project.pkg.name}/data">
      <fileset dir="${bldDir}/cran/staged">
        <include name="*.rda"/>
      </fileset>
    </copy>

    <delete dir="${bldDir}/cran/staged" />

    <copy todir="${bldDir}/cran/${project.pkg.name}/data">
      <fileset dir="${pkgDir}/data">
        <include name="*.RData"/>
      </fileset>
    </copy>

  </target>

  
  
  <!--
    ========================================================================
      Internal target:  package-generic
    ========================================================================
  -->
  <target name="package-generic" depends="clean,internal.osPrep,internal.setCranLibs,source-package">


    <exec dir="${bldDir}/cran" executable="R" failonerror="TRUE">
      <arg line="--vanilla"/>
      <arg line="CMD check --as-cran ${project.pkg.name}"/>
    </exec>

    <exec dir="${bldDir}/cran" executable="R" failonerror="TRUE">
      <arg line="CMD build --resave-data ${project.pkg.name}"/>
    </exec>
  </target>

  <!--
    ========================================================================
      Internal target:  install-generic
    ========================================================================
  -->
  <target name="install-generic" depends="setSourceTree,internal.osPrep,internal.setCranLibs">
    <echo message="Install Package From Source Initiated in ${cranLibs}"/>
    <exec dir="${bldDir}/cran" executable="R" failonerror="TRUE">
      <arg line="--vanilla"/>
      <arg line="CMD INSTALL"/>
      <arg line="-l ${cranLibs} --build"/>
      <arg line="${project.pkg.name}"/>
    </exec>
  </target>

  <!--
    ========================================================================
      Internal target, serial-XX-generic
    ========================================================================
  -->
  <target name="serial-64-generic" depends="internal.setSerial64,quality"/>



  
  <!--
    ========================================================================
      External SOURCE CRAN targets follow.
    ========================================================================
  -->

  <!--
    ========================================================================
      CLEAN target, Entry Point
    ========================================================================
  -->
  <target name="clean" depends="setSourceTree">
    <delete dir="${bldDir}"/>
  </target>

  
  <!--
    ========================================================================
      SOURCE target, Entry Point
    ========================================================================
  -->
  <target name="source" depends="setSourceTree">
    <mkdir dir="${bldDir}"/>
    <mkdir dir="${bldDir}/cran"/>
    <zip destfile="${bldDir}/cran/boostmtree.${project.build}.zip"
         basedir="../"
         includes="boostmtree/**"
         excludes=""/>
    <tar destfile="${bldDir}/cran/boostmtree.${project.build}.tar"
         basedir="../"
         includes="boostmtree/**"
         excludes=""/>
  </target>


  <!--
    ========================================================================
      PACKAGE target, Entry Point
    ========================================================================
  -->
  <target name="package" depends="setMltvariate, package-generic"/>
  <target name="package-stealth" depends="setStealth, package-generic"/>

  
  <!--
    ========================================================================
      INSTALL target, Entry Point
    ========================================================================
  -->
  <target name="install" depends="setMltvariate, install-generic"/>
  <target name="install-stealth" depends="setStealth, install-generic"/>

  
 <!--
    ========================================================================
      PACKAGE-AND-INSTALL target, Entry Point
    ========================================================================
  -->
  <target name="package-and-install"     depends="package, install, serial"/>
  <target name="package-and-install-stealth" depends="package-stealth, install-stealth, serial-stealth"/>

  
  <!--
    ========================================================================
      SERIAL-XX target, DEFAULT Entry Point
    ========================================================================
  -->
  <target name="serial"        depends="setMltvariate,serial-64-generic"/>
  <target name="serial-stealth" depends="setStealth,serial-64-generic"/>


  <!--
    ========================================================================
      Help on usage.  List available targets
    ========================================================================
    -->
  <target name="usage" depends="internal.init">
    <echo message=""/>
    <echo message=" Available targets are:"/>
    <echo message=""/>
    <echo message=" clean"/>
    <echo message="     --> delete the build tree"/>
    <echo message=""/>
    <echo message=" source"/>
    <echo message="     --> generate a tar/zip file of the source tree"/>
    <echo message=""/>
    <echo message=" package"/>
    <echo message=" package-stealth"/>
    <echo message="     --> generate the CRAN source package"/>
    <echo message=""/>
    <echo message=" install"/>
    <echo message=" install-stealth"/>
    <echo message="     --> install the CRAN serial package"/>
    <echo message=""/>
    <echo message=" package-and-install"/>
    <echo message=" package-and-install-stealth"/>
    <echo message="     --> package and install the CRAN serial package"/>
    <echo message=""/>
    <echo message=" serial"/>
    <echo message="     --> build using 64-bit serial compiler"/>
    <echo message="     --> *** DEFAULT TARGET ***"/>
    <echo message=" serial-stealth"/>
    <echo message="     --> build using 64-bit serial compiler"/>
    <echo message=""/>
  </target>

</project>



