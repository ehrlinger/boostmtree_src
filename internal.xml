<?xml version="1.0"?>

<!-- ===================================================== -->
<!-- RFSRC build file           Apache Ant version 1.10.0  -->
<!-- ===================================================== -->

<project name="internal" basedir="." default="..." >

  <!--
    ========================================================================
    ========================================================================
      Internal common targets follow.  Not for end use.
    ========================================================================
    ========================================================================
  -->


  <!--
    ========================================================================
      Internal Target:  Initialize the build
    ========================================================================
  -->
  <target name="init" >
    <tstamp>
      <format property="DSTAMP" pattern="yyyy-MM-dd"/>
      <format property="TSTAMP" pattern="hh:mm:ss"/>
    </tstamp>

    <echo message="--------- ${project.name} ${project.version} ---------"/>
    <echo message=""/>
    <echo message="Build Tag:  ${project.build}"/>
    <echo message=""/>
    <echo message="Date:  ${DSTAMP}"/>
    <echo message="Time:  ${TSTAMP}"/>

    <echo message=""/>
    <echo message="Platform Details:"/>
    <echo message="  OS name    ${os.name}"/>
    <echo message="  OS version ${os.version}"/>
    <echo message="  OS arch    ${os.arch}"/>
    <echo message="  Java arch  ${sun.arch.data.model}"/>
  </target>


  <!--
    ========================================================================
      Internal Target:  Customization for Operating System
    ========================================================================
  -->
  <target name="osPrep" depends="win-8Prep,win-7Prep,linPrep,mac-i386Prep,mac-x86_64Prep,sunPrep" /> 

  <target name="win-8Prep" depends="checkOS" if="isWin-8">
    <property name="sep" value="\"/>
    <property name="csep" value=";"/>
    <property name="scriptExtension" value=".cmd"/>
    <property name="scriptFileCommentLine" value="@echo off"/>
    <property name="scriptFileExitLine" value="exit /b"/>
    <property name="nativeDir" value="win-8"/>
    <property name="archiveType" value="zip"/>

    <property name="Rlib64" value="x64"/>

    <property name="sharedObjectExtension" value=".dll"/>
    
    <echo message="Customization for Windows 8"/>
  </target>

  <target name="win-7Prep" depends="checkOS" if="isWin-7">
    <property name="sep" value="\"/>
    <property name="csep" value=";"/>
    <property name="scriptExtension" value=".cmd"/>
    <property name="scriptFileCommentLine" value="@echo off"/>
    <property name="scriptFileExitLine" value="exit /b"/>
    <property name="nativeDir" value="win-7"/>
    <property name="archiveType" value="zip"/>

    <property name="Rlib64" value="x64"/>

    <property name="sharedObjectExtension" value=".dll"/>
    
    <echo message="Customization for Windows 7"/>
  </target>

  <target name="linPrep" depends="checkOS" if="isLinux">
    <property name="sep" value="/"/>
    <property name="csep" value=":"/>
    <property name="scriptExtension" value=".sh"/>
    <property name="scriptFileCommentLine" value="#!/bin/bash"/>
    <property name="scriptFileExitLine" value="exit 0"/>
    <property name="nativeDir" value="lin"/>
    <property name="archiveType" value="tgz"/>

    <property name="sharedObjectExtension" value=".so"/>

    <echo message="Customization for Linux"/>
  </target>

  <target name="mac-i386Prep" depends="checkOS" if="isMac-i386">
    <property name="sep" value="/"/>
    <property name="csep" value=":"/>
    <property name="scriptExtension" value=".sh"/>
    <property name="scriptFileCommentLine" value="#!/bin/bash"/>
    <property name="scriptFileExitLine" value="exit 0"/>
    <property name="nativeDir" value="mac-i386"/>
    <property name="archiveType" value="tgz"/>

    <property name="Rlib64" value="i386"/>

    <property name="sharedObjectExtension" value=".so"/>

    <echo message="Customization for Mac OS X (i386)"/>
  </target>

  <target name="mac-x86_64Prep" depends="checkOS" if="isMac-x86_64">
    <property name="sep" value="/"/>
    <property name="csep" value=":"/>
    <property name="scriptExtension" value=".sh"/>
    <property name="scriptFileCommentLine" value="#!/bin/bash"/>
    <property name="scriptFileExitLine" value="exit 0"/>
    <property name="nativeDir" value="mac-x86_64"/>
    <property name="archiveType" value="tgz"/>

    <property name="Rlib64" value="x86_64"/>

    <property name="sharedObjectExtension" value=".so"/>

    <echo message="Customization for Mac OS X (x86_64)"/>
  </target>

  <target name="sunPrep" depends="checkOS" if="isSun">
    <property name="sep" value="/"/>
    <property name="csep" value=":"/>
    <property name="scriptExtension" value=".sh"/>
    <property name="scriptFileCommentLine" value="#!/bin/bash"/>
    <property name="scriptFileExitLine" value="exit 0"/>
    <property name="nativeDir" value="sun"/>
    <property name="archiveType" value="tgz"/>

    <property name="sharedObjectExtension" value=".so"/>

    <echo message="Customization for Sun"/>
  </target>


  <!--
    ========================================================================
      Internal Target:  Determine Operating System.
    ========================================================================
  -->
  <target name="checkOS">
    <condition property="isWin-8">
      <os name="Windows 8"/>
    </condition>
    <condition property="isWin-7">
      <os name="Windows 7"/>
    </condition>
    <condition property="isLinux">
      <os name="Linux"/>
    </condition>
    <condition property="isSun">
      <os name="SunOS"/>
    </condition>
    <condition property="isMac-i386">
      <and>
        <os name="Mac OS X"/>
        <os arch="i386"/>
      </and>
    </condition>
    <condition property="isMac-x86_64">
      <and>
        <os name="Mac OS X"/>
        <os arch="x86_64"/>
      </and>
    </condition>
  </target>


  <!--
    ========================================================================
      Internal Target:  Set for Parallel or Serial
    ========================================================================
  -->
  <target name="setParallel64" depends="osPrep,set64">
    <property name="openMPcompiler" value="-fopenmp" />
    <property name="openMPforce" value="HAVE_OPENMP"/>

  </target>

  <target name="setSerial64" depends="osPrep,set64">
    <property name="openMPcompiler" value="" />
    <property name="openMPforce" value="DO_NOT_HAVE_OPENMP"/>
  </target>


  <!--
    ========================================================================
      Internal Target:  Set for 64 bits
    ========================================================================
  -->
  <target name="set64" depends="set64win-8,set64win-7,set64lin,set64mac-i386,set64mac-x86_64,set64sun">
    <property name="bitSwitch" value="m64" />
  </target>

  <target name="set64win-8" depends="checkOS" if="isWin-8">
    <property name="Rarch" value="--arch x64"/>
    <property name="Rlib" value="${Rlib64}"/>
    <property name="gnuCC" value="gcc" />
  </target>

  <target name="set64win-7" depends="checkOS" if="isWin-7">
    <property name="Rarch" value="--arch x64"/>
    <property name="Rlib" value="${Rlib64}"/>
    <property name="gnuCC" value="gcc" />
  </target>

  <target name="set64lin" depends="checkOS" if="isLinux">
    <property name="Rarch" value=""/>
    <property name="Rlib" value=""/>
    <property name="gnuCC" value="gcc"/>
  </target>

  <target name="set64mac-i386" depends="checkOS" if="isMac-i386">
    <property name="Rarch" value=""/>
    <property name="Rlib" value="${Rlib64}"/>
    <property name="gnuCC" value="gcc"/>
  </target>

  <target name="set64mac-x86_64" depends="checkOS" if="isMac-x86_64">
    <property name="Rarch" value=""/>
    <property name="Rlib" value="${Rlib64}"/>
    <property name="gnuCC" value="gcc"/>
  </target>

  <target name="set64sun" depends="checkOS" if="isSun">
  </target>



  <!--
    ========================================================================
      Internal Target:  Set CRAN library location
    ========================================================================
  -->
  <target name="setCranLibs">
    <property name="cranLibs" value="${env.R_LIBS}" />
  </target>

  <!--
    ========================================================================
      Internal Target:  Check for R architecture
    ========================================================================
  -->
  <target name="isRarchSet" >
    <fail message="Please specify 32-bit or 64-bit action.">
      <condition>
        <not>
          <isset property="Rarch"/>
        </not>
      </condition>
    </fail>
  </target>


  <!--
    ========================================================================
      Internal Target:  Test for source tree.
    ========================================================================
  -->
  <target name="testSourceTree">
    <property file="docs/source.properties"/>

    <fail message="This target must be run from the source tree.">
      <condition>
        <not>
          <istrue value="${sourceTree}"/>
        </not>
      </condition>
    </fail>
  </target>


  <!--
    ========================================================================
      Internal Target:  Test for build tree.
    ========================================================================
  -->
  <target name="testBuildTree">
    <property file="build.properties"/>

    <fail message="This target must be run from the build tree.">
      <condition>
        <not>
          <istrue value="${buildTree}"/>
        </not>
      </condition>
    </fail>
  </target>

  <target name="usage" depends="init">
    <echo message=""/>
    <echo message=" There are no available targets."/>
    <echo message=" You should not even be looking at this file."/>
    <echo message=""/>
  </target>

</project>



